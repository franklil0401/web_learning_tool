# 阿里云 DashScope API 配置
DASHSCOPE_API_KEY=your_dashscope_api_key

# RAG 配置
RAG_EMBEDDING_BACKEND=dashscope  # 可选: local, dashscope
RAG_RERANK_BACKEND=dashscope  # 可选: local, dashscope

# 阿里云模型配置（当使用 dashscope 后端时）
RAG_DASHSCOPE_EMBED_MODEL=text-embedding-v1
RAG_EMBEDDING_DIM=1536
RAG_DASHSCOPE_RERANK_MODEL=gte-rerank-v2
RAG_QWEN_MODEL=qwen-plus-2025-07-28

# 系统配置
ENABLE_LIVE_RAG=1  # 启用实时 RAG 索引
